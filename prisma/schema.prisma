generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// USERS & AUTH
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  business      Business?     @relation("BusinessOwner")
  staff         Staff?
  bookings      Booking[]
  queueEntries  QueueEntry[]
  reviews       Review[]
  customerPoints CustomerPoints?
  referralsMade Referral[]    @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// INDUSTRY TEMPLATES
// ──────────────────────────────────────────────

model IndustryTemplate {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  description   String
  category      String    // "beauty", "healthcare", "automotive", "government", "retail", "fitness"
  icon          String
  queueType     String    // "ticket", "appointment", "slot", "number"
  features      Json      // ["portfolio", "booking", "analytics", "sms"]
  defaultServices Json    // [{ name: "Haircut", duration: 30, price: 25 }]
  createdAt     DateTime  @default(now())

  businesses    Business[]
}

// ──────────────────────────────────────────────
// BUSINESS (Multi-tenant)
// ──────────────────────────────────────────────

model Business {
  id            String    @id @default(cuid())
  ownerId       String
  templateId    String
  name          String
  slug          String    @unique
  description   String?
  phone         String
  email         String
  address       String
  city          String
  state         String?
  zipCode       String?
  country       String    @default("US")
  latitude      Float?
  longitude     Float?
  logoUrl       String?
  coverUrl      String?
  openingHours  Json      // { mon: { open: "09:00", close: "18:00" }, ... }
  settings      Json      // { smsEnabled: true, aiEnabled: true, ... }
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner         User      @relation("BusinessOwner", fields: [ownerId], references: [id])
  template      IndustryTemplate @relation(fields: [templateId], references: [id])
  staff         Staff[]
  services      Service[]
  queues        Queue[]
  bookings      Booking[]
  reviews       Review[]

  @@unique([ownerId])
  @@index([slug])
  @@index([templateId])
}

model Staff {
  id            String    @id @default(cuid())
  businessId    String
  userId        String    @unique
  bio           String?
  specialties   String[]
  yearsExp      Int?
  avatarUrl     String?
  rating        Float     @default(0)
  totalReviews  Int       @default(0)
  isAvailable   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
  business      Business  @relation(fields: [businessId], references: [id])
  services      StaffService[]
  bookings      Booking[]
  queueEntries  QueueEntry[]
  portfolio     PortfolioImage[]
  reviews       Review[]

  @@index([businessId])
}

// ──────────────────────────────────────────────
// SERVICES
// ──────────────────────────────────────────────

model Service {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  description String?
  duration    Int       // minutes
  price       Float
  category    String    // "haircut", "beard", "dental", "repair", etc.
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id])
  staff       StaffService[]
  bookings    Booking[]

  @@index([businessId])
  @@index([category])
}

model StaffService {
  id        String  @id @default(cuid())
  staffId   String
  serviceId String
  price     Float?  // Override price (nullable = use service default)

  staff   Staff   @relation(fields: [staffId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([staffId, serviceId])
}

// ──────────────────────────────────────────────
// BOOKINGS
// ──────────────────────────────────────────────

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  staffId         String
  serviceId       String
  businessId      String
  scheduledAt     DateTime
  duration        Int           // minutes
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  stripePaymentId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer  User            @relation(fields: [customerId], references: [id])
  staff     Staff           @relation(fields: [staffId], references: [id])
  service   Service         @relation(fields: [serviceId], references: [id])
  business  Business        @relation(fields: [businessId], references: [id])

  @@index([customerId])
  @@index([staffId])
  @@index([businessId])
  @@index([scheduledAt])
  @@index([status])
}

// ──────────────────────────────────────────────
// QUEUE MANAGEMENT
// ──────────────────────────────────────────────

model Queue {
  id              String    @id @default(cuid())
  businessId      String
  name            String    @default("Walk-in Queue")
  queueType       String    @default("ticket") // ticket, appointment, slot, number
  isActive        Boolean   @default(true)
  currentNumber   Int       @default(0)
  estimatedWait   Int       @default(0) // minutes
  avgServiceTime  Int       @default(20) // minutes
  maxCapacity     Int?      // null = unlimited
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business    Business    @relation(fields: [businessId], references: [id])
  entries     QueueEntry[]

  @@index([businessId])
}

model QueueEntry {
  id            String      @id @default(cuid())
  queueId       String
  customerId    String
  staffId       String?
  ticketNumber  Int
  status        QueueStatus @default(WAITING)
  serviceType   String?
  joinedAt      DateTime    @default(now())
  calledAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  queue     Queue          @relation(fields: [queueId], references: [id])
  customer  User           @relation(fields: [customerId], references: [id])
  staff     Staff?         @relation(fields: [staffId], references: [id])

  @@index([queueId])
  @@index([customerId])
  @@index([status])
}

// ──────────────────────────────────────────────
// PORTFOLIO
// ──────────────────────────────────────────────

model PortfolioImage {
  id          String    @id @default(cuid())
  staffId     String
  imageUrl    String
  caption     String?
  category    String    // "haircut", "dental", "repair", "nail", etc.
  tags        String[]
  likes       Int       @default(0)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  staff       Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([category])
}

// ──────────────────────────────────────────────
// REVIEWS
// ──────────────────────────────────────────────

model Review {
  id          String    @id @default(cuid())
  customerId  String
  businessId  String
  staffId     String?
  rating      Int       // 1-5
  comment     String?
  images      String[]
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer  User            @relation(fields: [customerId], references: [id])
  business  Business        @relation(fields: [businessId], references: [id])
  staff     Staff?          @relation(fields: [staffId], references: [id])

  @@index([businessId])
  @@index([staffId])
  @@index([rating])
}

// ──────────────────────────────────────────────
// CUSTOMER RANKING & POINTS
// ──────────────────────────────────────────────

model CustomerPoints {
  id            String    @id @default(cuid())
  customerId    String    @unique
  points        Int       @default(0)
  tier          Tier      @default(BRONZE)
  totalVisits   Int       @default(0)
  totalSpent    Float     @default(0)
  streakDays    Int       @default(0)
  lastVisitAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer      User      @relation(fields: [customerId], references: [id])
  rewards       Reward[]

  @@index([tier])
  @@index([points])
}

model Reward {
  id              String    @id @default(cuid())
  pointsId        String
  name            String
  description     String?
  pointsCost      Int
  type            RewardType
  isRedeemed      Boolean   @default(false)
  redeemedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  points          CustomerPoints @relation(fields: [pointsId], references: [id])

  @@index([pointsId])
}

// ──────────────────────────────────────────────
// REFERRALS
// ──────────────────────────────────────────────

model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referredId    String?
  code          String    @unique
  status        ReferralStatus @default(PENDING)
  rewardEarned  Int       @default(0)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  referrer      User @relation("Referrer", fields: [referrerId], references: [id])
  referred      User? @relation("Referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([code])
}

// ──────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  data        Json?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

// ──────────────────────────────────────────────
// API KEYS (for platform API access)
// ──────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  key         String    @unique
  permissions Json      // ["read", "write", "admin"]
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId])
  @@index([key])
}

// ──────────────────────────────────────────────
// WEBHOOKS (for n8n integration)
// ──────────────────────────────────────────────

model Webhook {
  id          String    @id @default(cuid())
  businessId  String
  url         String
  events      Json      // ["queue.joined", "booking.created", "staff.called"]
  isActive    Boolean   @default(true)
  secret      String
  createdAt   DateTime  @default(now())

  @@index([businessId])
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  BUSINESS_OWNER
  ADMIN
}

enum Plan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum RewardType {
  DISCOUNT
  FREE_SERVICE
  PRIORITY_BOOKING
  EXCLUSIVE_ACCESS
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  QUEUE_UPDATE
  QUEUE_YOUR_TURN
  REWARD_EARNED
  REFERRAL_COMPLETE
  PROMOTIONAL
  SYSTEM
}
