# Database (Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-node-e-crypto-random-bytes-32-to-string-base64"

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_NAME="QueueForge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# n8n Automation (optional - self-hosted on Oracle VPS)
N8N_API_KEY=""
N8N_WEBHOOK_URL="http://localhost:5678"

# Resend (platform-level for auth emails)
RESEND_API_KEY="re_your_api_key_here"

# Stripe (for plan upgrades - optional, UPI is free)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""

# Cron job auth
CRON_SECRET="your-random-secret-here"

# Telegram (free notifications for owners)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# UPI (free payments - your UPI ID)
UPI_ID="yourname@upi"
